<?xml version="1.0"?>

<launch>
      <!--Nombre del cuerpo rigido-->
  <arg name="frame"/>   
  <arg name="worldFrame" default="world"/>
  <arg name="tf_prefix" default="" />

  <node name="controller" pkg="crazyflie_controller" type="crazyflie_controllerTC" output="screen">
    <param name="frame" value="$(arg frame)" />
    <param name="worldFrame" value="$(arg worldFrame)" />
    <rosparam command="load" file="$(find crazyflie_controller)/config/TC.yaml" />
  </node>

</launch>
