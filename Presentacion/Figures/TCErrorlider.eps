{{
/RawData currentfile /ASCII85Decode filter def
/Data RawData /FlateDecode filter def
/DeviceRGB setcolorspace
<<
  /ImageType 1
  /Decode [0 1 0 1 0 1]
  /DataSource Data
  /Height 1429
  /ImageMatrix [2542 0 0 1429 0 0]
  /Width 2542
  /BitsPerComponent 8
>> image
} stopped {handleerror} if
  RawData flushfile
} exec
