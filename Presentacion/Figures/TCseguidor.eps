1 GC
N
0 0 2520 1298 re
f
GR
GS
[0.48 0 0 0.48011 0 303.92749] CT
[1 0 0 1 0 0] CT
N
0 -632 M
4000 -632 L
4000 1429 L
0 1429 L
0 -632 L
cp
clip
GS
0 0 translate
2542 1429 scale
%AXGBeginBitmap: java.awt.image.BufferedImage
{{
/RawData currentfile /ASCII85Decode filter def
/Data RawData /FlateDecode filter def
/DeviceRGB setcolorspace
<<
  /ImageType 1
  /Decode [0 1 0 1 0 1]
  /DataSource Data
  /Height 1429
  /ImageMatrix [2542 0 0 1429 0 0]
  /Width 2542
  /BitsPerComponent 8
>> image
} stopped {handleerror} if
  RawData flushfile
} exec
