<?xml version="1.0"?>
<launch>
  <arg name="uri1" default="radio://0/80/2M/E7E7E7E701" />
  <arg name="frame1" default="crazyflie1" />

  <include file="$(find crazyflie)/launch/crazyflie_server.launch">
  </include>

  <group ns="crazyflie1">
    <include file="$(find crazyflie)/launch/crazyflie_add.launch">
      <arg name="uri" value="$(arg uri1)" />
      <arg name="tf_prefix" value="crazyflie1" />
    </include>
<!-- 
    <node name="crazyflie_ctrl" pkg="crazyflie_controller" type="controller.py">
      <param name="frame" value="$(frame1)" />
    </node>

    <node name="crazyflie_demo" pkg="crazyflie_demo" type="demo1.py">
      <param name="frame" value="$(frame1)" />
    </node> -->
  </group>

  <!-- run vicon bridge -->
  <!-- <include file="$(find vicon_bridge)/launch/vicon.launch"/> -->

</launch>
