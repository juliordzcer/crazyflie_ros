<?xml version="1.0"?>
<launch>
  <arg name="joy_dev" default="/dev/input/js0" />

  <arg name="uri1" default="radio://0/80/2M/E7E7E7E701" />
  <arg name="uri2" default="radio://1/90/2M/E7E7E7E702" /> 
  <!-- <arg name="uri1" default="radio://1/70/2M/E7E7E7E703" />  -->

<!-- 
  Seleccione el controlador de orientacion:

  1.- PID (Bitcraze)
  2.- Mellinger (Bitcraze)
  3.- INDI (Bitcraze)
  4.- Brescanccini (Bitcraze)
  5.- Sliding Mode Control
  6.- Backstepping
  7.- Twisting Continuo
  8.- Super Twisting Algoritm
  9.- Nonsingular Terminal Sliding Mode Control
  10.- Singular Terminal Sliding Mode Control
  11.- PID (Newtons)
    -->
  <arg name="n1" default="1" /> 
  <arg name="n2" default="1" /> 
  <!-- <arg name="n3" default="1" />  -->


  <!-- Formaciones -->
  <arg name="xi1" default="-0.2" />
  <arg name="yi1" default="0.0" />
  <arg name="zi1" default="0.0" />

  <!-- Formaciones -->
  <arg name="xi2" default="0.2" />
  <arg name="yi2" default="0.0" />
  <arg name="zi2" default="0.0" />
  
  <!-- Parametros de la trayectoria deseada -->
  <arg name="r" default="0.15" />
  <arg name="h" default="0.5" />


  <arg name="frame1" default="crazyflie1" /> 
  <arg name="frame2" default="crazyflie2" /> 

  <arg name="ip" default="192.168.2.10" /> 
  <arg name="port" default="3883" />

  <include file="$(find crazyflie_driver)/launch/crazyflie_server.launch" />
  
  <node name="info" pkg="crazyflie_demo" type="publish_info_leader.py" output="screen" />


  <node name="guardar_datos" pkg="crazyflie_demo" type="GDLD.py" output="screen">
      <param name="n1" value="$(arg n1)" />
      <param name="n2" value="$(arg n2)" />
  </node>

  <group ns="crazyflie1">

    <node pkg="crazyflie_driver" type="crazyflie_add" name="crazyflie_add" output="screen">
      <param name="uri" value="$(arg uri1)" />
      <param name="tf_prefix" value="crazyflie1" />
    </node>

    <node name="joy" pkg="joy" type="joy_node" output="screen">
      <param name="dev" value="$(arg joy_dev)" />
    </node>

    <node name="joystick_controller" pkg="crazyflie_demo" type="controller.py" output="screen">
      <param name="use_crazyflie_controller" value="True" />
    </node>
    
    <node name="selc" pkg="crazyflie_demo" type="select_controller.py" output="screen">
        <param name="n" value="$(arg n1)" />
    </node>

    <include file="$(find crazyflie_controller)/launch/Leader.launch">
      <arg name="frame" value="$(arg frame1)" />
    </include>

    <node name="pose" pkg="crazyflie_demo" type="trajectory_node.py" output="screen">
        <param name="xi" value="$(arg xi1)" />
        <param name="yi" value="$(arg yi1)" />
        <param name="zi" value="$(arg zi1)" />
        <param name="h" value="$(arg h)" />
        <param name="r" value="$(arg r)" />
    </node>

    <node pkg="vrpn_client_ros" type="vrpn_client_node" name="vrpn_client_node" output="screen">
      <rosparam subst_value="true">
        server: $(arg ip)
        port: $(arg port)
        update_frequency: 100.0
        frame_id: world
        child_frame_id: $(arg frame1)
        use_server_time: false
        broadcast_tf: true
        refresh_tracker_frequency: 1.0
      </rosparam>
    </node>

      <node pkg="tf" type="static_transform_publisher" name="baselink_broadcaster" args="0 0 0 0 0 0 1 $(arg frame1) /crazyflie/base_link 100" />
    </group>


    <group ns="crazyflie2">

    <node pkg="crazyflie_driver" type="crazyflie_add" name="crazyflie_add" output="screen">
      <param name="uri" value="$(arg uri2)" />
      <param name="tf_prefix" value="crazyflie2" />
    </node>

    <node name="joy" pkg="joy" type="joy_node" output="screen">
      <param name="dev" value="$(arg joy_dev)" />
    </node>

    <node name="joystick_controller" pkg="crazyflie_demo" type="controller.py" output="screen">
      <param name="use_crazyflie_controller" value="True" />
    </node>
    
    <node name="selc" pkg="crazyflie_demo" type="select_controller.py" output="screen">
        <param name="n" value="$(arg n2)" />
    </node>

    <include file="$(find crazyflie_controller)/launch/Leader.launch">
      <arg name="frame" value="$(arg frame2)" />
    </include>

    <node name="pose" pkg="crazyflie_demo" type="trajectory_node.py" output="screen">
        <param name="xi" value="$(arg xi2)" />
        <param name="yi" value="$(arg yi2)" />
        <param name="zi" value="$(arg zi2)" />
        <param name="h" value="$(arg h)" />
        <param name="r" value="$(arg r)" />
    </node>

    <node pkg="vrpn_client_ros" type="vrpn_client_node" name="vrpn_client_node" output="screen">
      <rosparam subst_value="true">
        server: $(arg ip)
        port: $(arg port)
        update_frequency: 100.0
        frame_id: world
        child_frame_id: $(arg frame2)
        use_server_time: false
        broadcast_tf: true
        refresh_tracker_frequency: 1.0
      </rosparam>
    </node>

    <node pkg="tf" type="static_transform_publisher" name="baselink_broadcaster" args="0 0 0 0 0 0 1 $(arg frame2) /crazyflie/base_link 100" />
  </group>


  <!-- <group ns="crazyflie3">

    <node pkg="crazyflie_driver" type="crazyflie_add" name="crazyflie_add" output="screen">
