<?xml version="1.0"?>

<launch>
  <arg name="uri1" default="radio://0/90/2M/E7E7E7E702" />
  <arg name="frame1" default="crazyflie1" />
  <arg name="n" default="1" />

  <!-- 
  Seleccione el controlador de orientacion:

  1.- PID (Bitcraze)
  2.- Mellinger (Bitcraze)
  3.- INDI (Bitcraze)
  4.- Brescanccini (Bitcraze)
  5.- Sliding Mode Control
  6.- Backstepping
  7.- Twisting Continuo
  8.- Super Twisting Algoritm
  9.- Nonsingular Terminal Sliding Mode Control
  10.- Singular Terminal Sliding Mode Control
  11.- PID (Newtons)
    -->

    
  <!-- Iniciar el nodo crazyflie_server -->
  <node pkg="crazyflie_driver" type="crazyflie_server" name="crazyflie_server" output="screen" />

  <group ns="crazyflie1">
    <!-- Iniciar el nodo crazyflie_add -->
    <node pkg="crazyflie_driver" type="crazyflie_add" name="crazyflie_add" output="screen">
      <param name="uri" value="$(arg uri1)" />
      <param name="tf_prefix" value="crazyflie1" />
    </node>
  </group>

  <!-- Ejecutar el script Python update_params.py -->
  <node name="update_params_node" pkg="crazyflie_demo" type="update_params.py">
    <param name="frame" value="$(arg frame1)"/>
    <param name="n" value="$(arg n)"/>
  </node>
</launch>
