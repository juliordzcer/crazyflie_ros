save('STSMC_Errores_L.mat','EX1_STSMC_L','EX2_STSMC_L','EY1_STSMC_L','EY2_STSMC_L','EZ1_STSMC_L','EZ2_STSMC_L','EPHI1_STSMC_L','EPHI2_STSMC_L','ETHETA1_STSMC_L','ETHETA2_STSMC_L','EPSI1_STSMC_L','EPSI2_STSMC_L','t','-v7.3');
save('STSMC_Estados_L.mat','X1_STSMC_L','X2_STSMC_L','Y1_STSMC_L','Y2_STSMC_L','Z1_STSMC_L','Z2_STSMC_L','PHI1_STSMC_L','PHI2_STSMC_L','THETA1_STSMC_L','THETA2_STSMC_L','PSI1_STSMC_L','PSI2_STSMC_L','-v7.3');
save('STSMC_Deseadas_L.mat','XD1_STSMC_L','XD2_STSMC_L','YD1_STSMC_L','YD2_STSMC_L','ZD1_STSMC_L','ZD2_STSMC_L','PHID1_STSMC_L','PHID2_STSMC_L','THETAD1_STSMC_L','THETAD2_STSMC_L','PSID1_STSMC_L','PSID2_STSMC_L','-v7.3')
